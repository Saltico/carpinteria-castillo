---
// src/layouts/BaseLayout.astro
// Canonical layout for the entire site. All shared data imported from
// @/data/site.ts (env-driven) and @/i18n/* and distributed to components.
// i18n: locale-aware nav/footer/topbar + LanguageSwitcher (features.i18n).
// Dark mode: ThemeToggle (features.dark_mode).

import '@/styles/base.css';
import type { NavItem } from '@/types/navigation';
import type { FooterColumn, FooterLink, SocialLink } from '@/types/layout';
import type { BreadcrumbItem } from '@/types/seo';
import SkipLink from '@/components/layout/SkipLink.astro';
import TopBar from '@/components/layout/TopBar.astro';
import Header from '@/components/layout/Header.astro';
import Navigation from '@/components/layout/Navigation.astro';
import Footer from '@/components/layout/Footer.astro';
import SEO from '@/components/seo/SEO.astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import GTM from '@/components/analytics/GTM.astro';
import GA4 from '@/components/analytics/GA4.astro';
import ConsentBanner from '@/components/analytics/ConsentBanner.astro';
import ThemeToggle from '@/components/ui/ThemeToggle.astro';
import LanguageSwitcher from '@/components/ui/LanguageSwitcher.astro';
import {
  ui,
  localeAlternates,
  localePath,
  defaultLocale,
  type Locale,
  type RouteKey,
} from '@/i18n/ui';
import {
  getNavigation,
  getFooterData,
  getTopbarData,
  siteBrand,
  siteContact,
} from '@/data/site';
import {
  organizationSchema,
  websiteSchema,
  localBusinessSchema,
  breadcrumbSchema,
  getSiteUrl,
  DEFAULT_OG_IMAGE,
} from '@/lib/seo';
import { initAnalytics } from '@/lib/analytics';

export interface Props {
  title: string;
  description: string;
  locale?: Locale;
  routeKey?: RouteKey;
  canonical?: string;
  ogImage?: string;
  hreflang?: Record<string, string>;
  noindex?: boolean;
  breadcrumbs?: BreadcrumbItem[];
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  lang?: string;
  showTopBar?: boolean;
  showHeader?: boolean;
  showFooter?: boolean;
  topbar?: {
    phone?: string;
    email?: string;
    social?: SocialLink[];
    links?: Array<{ label: string; url: string }>;
  };
  navigation?: {
    items: NavItem[];
    ariaLabel?: string;
  };
  footer?: {
    columns: FooterColumn[];
    legal: FooterLink[];
    brand?: string;
    description?: string;
    phone?: string;
    email?: string;
    address?: string;
    schedule?: string;
    social?: SocialLink[];
    logoUrl?: string;
    logoAlt?: string;
    siteUrl?: string;
  };
  headerVariant?: 'default' | 'brand';
  immersive?: boolean;
}

const {
  title,
  description,
  locale = defaultLocale,
  routeKey,
  canonical: canonicalProp,
  ogImage,
  hreflang,
  noindex = false,
  breadcrumbs,
  jsonLd,
  lang: pageLang,
  showTopBar = true,
  showHeader = true,
  showFooter = true,
  topbar: topbarProp,
  navigation,
  footer: footerProp,
  headerVariant = 'default',
  immersive = false,
} = Astro.props;

const t = ui[locale];

// Astro.url already includes site + base + path → use directly as canonical fallback
const canonical = canonicalProp ?? Astro.url.href;
const htmlLang = pageLang ?? locale;
const ogImageUrl = ogImage ?? getSiteUrl(DEFAULT_OG_IMAGE);

// Analytics IDs from env vars (none configured in this phase)
const gtmId = import.meta.env.PUBLIC_GTM_ID;
const ga4Id = import.meta.env.PUBLIC_GA4_ID;

// ─── Locale-aware defaults ───────────────────────────────────────────
const topbar = topbarProp ?? getTopbarData(locale);
const navItems = navigation?.items ?? getNavigation(locale);
const navAriaLabel = navigation?.ariaLabel ?? t.mainNav;

const footerData = getFooterData(locale);
const topbarSocial = topbar.social ?? [];
const effectiveFooter = {
  columns: footerProp?.columns ?? footerData.columns,
  legal: footerProp?.legal ?? footerData.legal,
  brand: footerProp?.brand ?? siteBrand.name,
  description: footerProp?.description ?? t.footer.tagline,
  phone: footerProp?.phone ?? (siteContact.phone || undefined),
  email: footerProp?.email ?? (siteContact.email || undefined),
  address: footerProp?.address, // sin dirección física en el spec
  schedule: footerProp?.schedule, // sin horario público en el spec
  social: footerProp?.social ?? topbarSocial,
  logoUrl: footerProp?.logoUrl ?? siteBrand.logoDarkUrl,
  logoAlt: footerProp?.logoAlt ?? siteBrand.name,
          siteUrl: footerProp?.siteUrl ?? siteBrand.siteUrl,
          homeUrl: localePath('home', locale),
          homeLabel: t.nav.home,
          contactTitle: t.footer.contactTitle,
  copyrightText: t.footer.copyright,
};

const languageAlternates = routeKey ? localeAlternates(routeKey) : [];

const bodyClasses = [
  !showTopBar && 'topbar-hidden',
  immersive && 'immersive-hero',
]
  .filter(Boolean)
  .join(' ') || undefined;

// Base JSON-LD schemas injected on every page.
// LocalBusiness: solo con datos reales de contacto (sin dirección inventada).
const baseSchemas: Record<string, unknown>[] = [
  organizationSchema(),
  websiteSchema(),
];
if (siteContact.phone || siteContact.email) {
  baseSchemas.push(localBusinessSchema());
}
const pageSchemas = jsonLd ? (Array.isArray(jsonLd) ? jsonLd : [jsonLd]) : [];

// BreadcrumbList: TODO JSON-LD debe vivir en <head> (estándar SEO/GTM).
// Si la ruta provee breadcrumbs (prop de BaseLayout o schema vía jsonLd),
// se emite aquí una única vez — el componente visual Breadcrumbs.astro
// ya NO emite JSON-LD en el body.
const hasBreadcrumbSchema = pageSchemas.some(
  (schema) => schema['@type'] === 'BreadcrumbList'
);
const breadcrumbSchemas =
  breadcrumbs && !hasBreadcrumbSchema ? [breadcrumbSchema(breadcrumbs)] : [];

const allSchemas = [...baseSchemas, ...pageSchemas, ...breadcrumbSchemas];
---

<!doctype html>
<html lang={htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" href={`${import.meta.env.BASE_URL}/favicon.svg`} type="image/svg+xml" />

    <!-- Consent Mode defaults (before analytics) -->
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag(){dataLayer.push(arguments);}
      gtag('consent', 'default', {
        ad_storage: 'denied',
        analytics_storage: 'denied',
        wait_for_update: 500,
      });
    </script>

    <!-- Google Tag Manager (conditional) -->
    {gtmId && <GTM gtmId={gtmId} />}

    <!-- Google Analytics 4 (conditional) -->
    {ga4Id && <GA4 ga4Id={ga4Id} />}

    <!-- SEO component (desviación autorizada QA 2/2 S-1: x-default → locale por defecto) -->
    <SEO
      title={title}
      description={description}
      canonical={canonical}
      ogImage={ogImageUrl}
      hreflang={hreflang}
      defaultLocale={defaultLocale}
      noindex={noindex}
      jsonLd={allSchemas}
      lang={htmlLang}
    />

    <!-- Preload critical fonts (self-hosted, latin subset) -->
    <link rel="preload" href={`${import.meta.env.BASE_URL}/fonts/playfair-display-var-latin.woff2`} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={`${import.meta.env.BASE_URL}/fonts/inter-var-latin.woff2`} as="font" type="font/woff2" crossorigin />

    <script>
      // 1. Anti-FOUC: apply theme before first paint
      (function() {
        const s = localStorage.getItem('theme-preference');
        const t = s === 'dark' || s === 'light' ? s : (window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
        document.documentElement.setAttribute('data-theme', t);
      })();

      // 2. Intersection Observer for reveal animations
      if ('IntersectionObserver' in window) {
        const revealObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (entry.isIntersecting) {
                entry.target.classList.add('is-visible');
                revealObserver.unobserve(entry.target);
              }
            });
          },
          { threshold: 0.1, rootMargin: '0px 0px -60px 0px' }
        );

        document.querySelectorAll('.reveal, .reveal-up, .reveal-scale').forEach((el) => {
          revealObserver.observe(el);
        });
      }
    </script>

    <slot name="head" />
  </head>
  <body class={bodyClasses}>
    <!-- Consent Banner -->
    {(gtmId || ga4Id) && <ConsentBanner />}

    <SkipLink targetId="main-content" label={t.skipToContent} />

    {showTopBar && <TopBar phone={topbar.phone} email={topbar.email} social={topbar.social} links={topbar.links} />}

    {
      showHeader && (
        <Header variant={headerVariant}>
          <a href={localePath('home', locale)} slot="logo" class="header-logo" aria-label={`${siteBrand.name} - ${t.nav.home}`}>
            <img
              src={siteBrand.logoUrl}
              alt={siteBrand.name}
              width={300}
              height={48}
              class="header-logo__img"
              loading="eager"
              decoding="async"
            />
          </a>
          <Navigation
            slot="navigation"
            items={navItems}
            ariaLabel={navAriaLabel}
            menuTitle={t.menuTitle}
            openMenuLabel={t.openMenu}
            closeMenuLabel={t.closeMenu}
            variant="default"
          >
            <Fragment slot="mobile-actions">
              <ThemeToggle toLightLabel={t.themeToLight} toDarkLabel={t.themeToDark} />
              {languageAlternates.length > 1 && (
                <LanguageSwitcher locales={languageAlternates} currentLocale={locale} ariaLabel={t.languageSelector} />
              )}
            </Fragment>
          </Navigation>
          <Fragment slot="cta">
            {languageAlternates.length > 1 && (
              <LanguageSwitcher locales={languageAlternates} currentLocale={locale} ariaLabel={t.languageSelector} />
            )}
            <ThemeToggle toLightLabel={t.themeToLight} toDarkLabel={t.themeToDark} />
          </Fragment>
        </Header>
      )
    }

    <main id="main-content" tabindex="-1">
      {breadcrumbs && <Breadcrumbs items={breadcrumbs} />}
      <slot />
    </main>

    {
      showFooter && (
        <Footer
          columns={effectiveFooter.columns}
          legal={effectiveFooter.legal}
          brand={effectiveFooter.brand}
          description={effectiveFooter.description}
          phone={effectiveFooter.phone}
          email={effectiveFooter.email}
          address={effectiveFooter.address}
          schedule={effectiveFooter.schedule}
          social={effectiveFooter.social}
          logoUrl={effectiveFooter.logoUrl}
          logoAlt={effectiveFooter.logoAlt}
          siteUrl={effectiveFooter.siteUrl}
          homeUrl={effectiveFooter.homeUrl}
          homeLabel={effectiveFooter.homeLabel}
          contactTitle={effectiveFooter.contactTitle}
          copyrightText={effectiveFooter.copyrightText}
        />
      )
    }

    <script>
      // Initialize analytics: listens to DOM events and sends to GTM dataLayer
      initAnalytics();
    </script>
  </body>
</html>

<style>
  .header-logo {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    line-height: 0;
  }

  .header-logo__img {
    width: auto;
    height: 2.25rem;
    max-width: 100%;
    object-fit: contain;
  }

  @media (min-width: 768px) {
    .header-logo__img {
      height: 2.5rem;
    }
  }

  main {
    min-height: 60vh;
  }

  main:focus {
    outline: none;
  }
</style>
