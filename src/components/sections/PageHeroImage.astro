---
// src/components/sections/PageHeroImage.astro
// Hero de páginas interiores (servicios/proyectos/contacto):
// imagen de fondo con overlay cálido + breadcrumbs + título + subheading.

import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import Breadcrumbs from '@/components/seo/Breadcrumbs.astro';
import type { BreadcrumbItem } from '@/types/seo';

interface Props {
  title: string;
  description?: string;
  image: ImageMetadata;
  breadcrumbs?: BreadcrumbItem[];
  imageAlt?: string;
}

const { title, description, image, breadcrumbs, imageAlt = '' } = Astro.props;
---

<section class="phero">
  <Image
    src={image}
    alt={imageAlt}
    widths={[640, 1024, 1440, 1920]}
    sizes="100vw"
    class="phero__media"
    loading="eager"
    decoding="async"
    fetchpriority="high"
  />
  <div class="phero__overlay" aria-hidden="true"></div>

  <div class="phero__content">
    {breadcrumbs && <Breadcrumbs items={breadcrumbs} variant="hero" />}
    <h1 class="phero__title">{title}</h1>
    {description && <p class="phero__description">{description}</p>}
  </div>
</section>

<style>
  .phero {
    position: relative;
    min-height: 420px;
    display: flex;
    align-items: flex-end;
    overflow: hidden;
    isolation: isolate;
  }

  .phero__media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
  }

  .phero__overlay {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      to bottom,
      rgba(44, 24, 16, 0.35),
      rgba(44, 24, 16, 0.78)
    );
    z-index: -1;
  }

  .phero__content {
    max-width: var(--breakpoint-xl);
    width: 100%;
    margin-inline: auto;
    padding-inline: var(--spacing-4);
    padding-block: var(--spacing-16);
    color: var(--color-on-dark);
  }

  @media (min-width: 768px) {
    .phero__content {
      padding-inline: var(--spacing-8);
    }
  }

  .phero__title {
    font-family: var(--font-heading);
    font-size: var(--text-h1);
    font-weight: 800;
    color: var(--color-on-dark);
    margin-bottom: var(--spacing-3);
  }

  .phero__description {
    font-size: var(--text-lead);
    line-height: 1.6;
    max-width: 640px;
    color: rgba(250, 246, 241, 0.92);
    text-wrap: balance;
  }
</style>
